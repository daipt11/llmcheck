# Configure your LLM models below.
# Use the prefix MODEL_1_, MODEL_2_, etc. to group configurations for each model.

# Example 1: OpenAI GPT-3.5
MODEL_1_NAME="OpenAI GPT-3.5"
MODEL_1_ALIAS="openai"
MODEL_1_PROVIDER="openai"
MODEL_1_MODEL="gpt-3.5-turbo"
MODEL_1_API_KEY="sk-your-openai-key"

# Example 2: Anthropic Claude 3
MODEL_2_NAME="Anthropic Claude 3 Haiku"
MODEL_2_ALIAS="claude"
MODEL_2_PROVIDER="anthropic"
MODEL_2_MODEL="claude-3-haiku-20240307"
MODEL_2_API_KEY="sk-ant-your-anthropic-key"

# Example 3: Custom provider (e.g., local OpenClaw, Ollama, vLLM) compatible with OpenAI format
MODEL_3_NAME="Local OpenClaw Llama 3"
MODEL_3_ALIAS="openclaw"
# Use 'openai' as provider for any OpenAI-compatible endpoint (Ollama, vLLM, etc.)
MODEL_3_PROVIDER="openai"
MODEL_3_MODEL="llama-3"
MODEL_3_API_KEY="dummy-key-if-not-required"
MODEL_3_BASE_URL="http://localhost:8000/v1"

# Example 4: Gemini model
MODEL_4_NAME="Google Gemini 1.5 Flash"
MODEL_4_PROVIDER="gemini"
MODEL_4_MODEL="gemini-1.5-flash"
MODEL_4_API_KEY="AIzaSy-your-google-api-key"
